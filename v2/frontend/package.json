{
  "name": "wiki-polis-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run api:generate && tsc -b && vite build",
    "preview": "vite preview",
    "api:generate": "openapi-typescript ../openapi.json -o src/api/schema.ts",
    "typecheck": "npm run api:generate && tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "latest",
    "openapi-fetch": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "msw": "latest",
    "openapi-typescript": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
