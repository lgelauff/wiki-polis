FLASK_DEBUG=1
FLASK_APP=app.py

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# URLs for the backend services (particiapp-docker stack)
PARTICIAPI_BASE_URL=http://localhost:8000
POLIS_SERVER_URL=http://localhost:8001
POLIS_PUBLIC_URL=http://localhost:4000

# Direct Postgres connection for admin stats panel (leave blank to disable)
POLIS_DATABASE_URL=postgresql://polis:polis@127.0.0.1:5432/polis

# Local Polis admin credentials (set in particiapp-docker/.env)
POLIS_ADMIN_EMAIL=admin@test.com
POLIS_ADMIN_PASSWORD=localdev

# Wikimedia username(s) with admin access, comma-separated
ADMIN_USERS=YourWikimediaUsername

# Local dev login bypass — skips OAuth, sets session as this Wikimedia username
# Only active when FLASK_DEBUG=1 and not running on Toolforge
DEV_LOGIN_USER=YourWikimediaUsername

# Leave blank for local dev — /login redirects to /dev-login when DEV_LOGIN_USER is set
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
