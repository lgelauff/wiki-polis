FLASK_DEBUG=1
FLASK_APP=app.py

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-key

# Wikimedia username(s) with admin access, comma-separated.
ADMIN_USERS=DevUser

# Local dev login bypass. Only active when FLASK_DEBUG=1 and not on Toolforge.
DEV_LOGIN_USER=DevUser

# Local Flask database. v2 dev mode refuses non-SQLite DEV_DATABASE_URL values.
DEV_DATABASE_URL=sqlite:///dev.db

# Set to 1 to show hardcoded dev-user-1/2/3 badges on the home page (fake login, no OAuth).
# Only active in local debug mode; never set in production.
DEV_FAKE_LOGIN=

# URLs for the backend services exposed by dev.sh / docker-compose.wiki-polis.local.yaml.
PARTICIAPI_BASE_URL=http://127.0.0.1:8002
POLIS_SERVER_URL=http://127.0.0.1:8003

# Leave blank for local dev and Toolforge (TOOL_REDIS_URI is used automatically). Set only when running on a plain VPS, e.g. redis://<host>:6379/0.
RATELIMIT_STORAGE_URI=

# Unique prefix for Redis rate-limit keys. Production: set to e.g. "wiki-polis-dev:<random>:".
# Generate random suffix with: python3 -c "import secrets; print(secrets.token_hex(8))"
RATELIMIT_KEY_PREFIX=

# Secret used to hash client identities in Redis rate-limit keys (prevents raw IP exposure).
# Production: generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
RATELIMIT_IDENTITY_SECRET=

# Leave blank for local dev. Production must set comma-separated allowed hostnames.
TRUSTED_HOSTS=

# Public-facing Polis URL used to build result links. Defaults to https://pol.is if unset.
POLIS_PUBLIC_URL=

# Direct Postgres connection for admin stats panel.
POLIS_DATABASE_URL=postgresql://polis:polis@127.0.0.1:5433/polis

# Optional local Polis admin credentials for automated conversation creation.
# Leave blank to enter a polis_id manually in the wiki-polis admin form.
POLIS_ADMIN_EMAIL=
POLIS_ADMIN_PASSWORD=

# Leave blank for local dev. /login redirects to /dev-login when DEV_LOGIN_USER is set.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
